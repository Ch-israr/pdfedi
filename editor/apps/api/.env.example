# Port for the Fastify service
PORT=4000
# Host binding (0.0.0.0 in docker, 127.0.0.1 locally)
HOST=127.0.0.1
# Shared secret with the FastAPI backend for HS256 JWT verification.
# MUST match the secret FastAPI uses to sign tokens.
JWT_SECRET=change-me-in-production
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000
# Redis URL for BullMQ (heavy jobs: OCR, large merges)
REDIS_URL=redis://localhost:6379
# Max upload size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800
# Log level: debug | info | warn | error
LOG_LEVEL=info
