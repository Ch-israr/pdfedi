# PDFEDI Frontend — Environment Configuration
# Copy to .env.local for local development. NEVER commit .env.local with real URLs.
# On Vercel, set NEXT_PUBLIC_API_URL in the project dashboard.

# Backend API base URL (no trailing slash)
# Local development: http://localhost:8000/api/v1 (or your backend port)
# Production (Vercel): https://your-backend-domain.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
