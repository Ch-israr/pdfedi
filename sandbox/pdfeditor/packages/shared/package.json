{
  "dependencies": {
    "zod": "^3.24.1"
  },
  "description": "Shared Zod schemas and TypeScript types for the PDF editor",
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "name": "@pdfeditor/shared",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "echo \"no lint configured\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "types": "./dist/index.d.ts",
  "version": "0.1.0",
  "type": "module"
}